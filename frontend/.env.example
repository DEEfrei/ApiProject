# URL du backend principal (gateway REST) - fourni par le membre backend
# En local :
VITE_API_URL=http://localhost:4000
# En production (une fois backend-main deploye sur Render), remplacer par ex. :
# VITE_API_URL=https://cinematch-backend-main.onrender.com

# URL de base du frontend (utile pour la redirection OAuth Google configuree cote backend)
# En local :
VITE_FRONTEND_URL=http://localhost:5173
# En production (une fois le frontend deploye sur Vercel) :
# VITE_FRONTEND_URL=https://cinematch.vercel.app
